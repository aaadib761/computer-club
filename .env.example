# Copy this file to .env and fill in real values. Never commit .env.

# Port the server listens on
PORT=3000

# Secret used to sign admin logins. Use at least 32 random characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Set to "production" when the site is live (turns on HTTPS-only headers and stricter checks)
NODE_ENV=development

# Set to 1 when running behind a hosting proxy (Render, Railway, nginx...) so rate limits work
# TRUST_PROXY=1

# The site's public address once it's live. Membership card QR codes point here,
# so set it BEFORE printing cards (e.g. https://ndubcc.example.com)
# PUBLIC_URL=
